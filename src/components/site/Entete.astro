---
// En-tête du site public (design system, section 23 : st-entete + st-progression).
// Balisage repris de la planche 19-site-composants (C.entete).
interface Props { actif?: 'ressources' | 'app' | 'qui'; progression?: boolean }
const { actif, progression = false } = Astro.props;
const BURGER = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 8h14M5 16h14"/></svg>';
const liens = [
  { cle: 'ressources', href: '/ressources/', texte: 'Ressources' },
  { cle: 'app', href: '/#tempo', texte: "L'app" },
  { cle: 'qui', href: '/qui-sommes-nous/', texte: 'Qui sommes-nous' },
];
---
<header class="st-entete">
  <a class="st-marque" href="/">tempo</a>
  <nav class="st-nav" aria-label="Navigation principale">
    {liens.map((l) => <a href={l.href} aria-current={actif === l.cle ? 'page' : undefined}>{l.texte}</a>)}
  </nav>
  <a class="bouton" href="#liste-attente" data-ouvrir-inscription>Rejoindre la liste d'attente</a>
  <button class="st-burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" data-burger set:html={BURGER} />
  {progression && <div class="st-progression" aria-hidden="true"><i></i></div>}
</header>
