---
// Politique de confidentialité (24/11/2026). Champs [À COMPLÉTER] : voir mentions-legales.astro.
import SiteLayout from '../layouts/SiteLayout.astro';
import TetePage from '../components/site/TetePage.astro';
---
<SiteLayout title="Politique de confidentialité — Tempo" description="Quelles données Tempo collecte, pourquoi, combien de temps, et comment exercer vos droits." path="/confidentialite/">
  <div class="page-simple">
    <TetePage titre="Politique de confidentialité" ariane="Confidentialité" chapeau="Ce que Tempo collecte sur ce site, pourquoi, et comment garder la main sur vos données." />
    <div class="st-texte">
      <h2>Qui est responsable de vos données</h2>
      <p>[À COMPLÉTER : nom ou raison sociale de l'éditeur], joignable à [À COMPLÉTER : adresse e-mail de contact].</p>

      <h2>La liste d'attente de l'app</h2>
      <ul>
        <li><strong>Ce que nous gardons</strong> : votre adresse e-mail, la date de votre inscription et la page du site d'où vous vous êtes inscrit. Rien d'autre.</li>
        <li><strong>Pourquoi</strong> : vous prévenir de l'ouverture de l'app Tempo et, si vous le souhaitez, vous inviter à la tester. Aucune publicité, aucune revente, aucun partage avec des tiers.</li>
        <li><strong>Sur quelle base</strong> : votre consentement, donné en vous inscrivant. Vous pouvez le retirer à tout moment.</li>
        <li><strong>Où</strong> : chez notre hébergeur Cloudflare, dans un espace de stockage restreint à l'Union européenne.</li>
        <li><strong>Combien de temps</strong> : [À COMPLÉTER : par exemple jusqu'à l'ouverture de l'app, puis 12 mois au plus], ou jusqu'à votre demande de suppression.</li>
      </ul>

      <h2>La mesure d'audience</h2>
      <p>[À COMPLÉTER : section à écrire une fois la mesure d'audience tranchée.]</p>

      <h2>Vos droits</h2>
      <p>Vous pouvez demander à consulter, corriger ou supprimer vos données, ou vous opposer à leur utilisation, en écrivant à [À COMPLÉTER : adresse e-mail de contact]. Nous répondons sous un mois. Si vous estimez que vos droits ne sont pas respectés, vous pouvez saisir la CNIL (cnil.fr).</p>
    </div>
  </div>
</SiteLayout>
