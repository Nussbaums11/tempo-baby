---
// Page 404 personnalisée. Astro construit automatiquement ce fichier en
// /404.html à la racine du build (convention reconnue par Cloudflare Pages
// et la plupart des hébergeurs statiques) : elle s'affiche pour toute URL
// qui ne correspond à aucune route existante.
// Refonte du 24/11/2026 : gabarit du design system, illustration du catalogue à la place de l'emoji.
import SiteLayout from '../layouts/SiteLayout.astro';
import { illustration } from '../lib/tempo';
const suggestions = [
  { href: '/ressources/', label: 'Voir toutes les ressources' },
  { href: '/#tempo', label: "Découvrir l'app" },
  { href: '/qui-sommes-nous/', label: 'Qui sommes-nous' },
];
---
<SiteLayout
  title="Page introuvable — Tempo"
  description="Cette page n'existe pas ou plus. Retrouvez nos guides et notre application depuis la page d'accueil Tempo."
  path="/404/"
>
  <div class="page-simple centre">
    <div class="st-tete-article">
      <div set:html={illustration('poussette', 120)} />
      <h1>Cette page s'est perdue en route</h1>
      <p class="st-chapeau">La page que vous cherchez n'existe pas, ou a changé d'adresse. Rien de grave : voici où retrouver ce qui vous intéresse probablement.</p>
    </div>
    <div class="st-actions">
      <a class="bouton secondaire" href="/">Retour à l'accueil</a>
      {suggestions.map((s) => <a class="bouton secondaire" href={s.href}>{s.label}</a>)}
    </div>
  </div>
</SiteLayout>
