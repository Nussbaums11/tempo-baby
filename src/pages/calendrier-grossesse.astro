---
// Page mère du cocon « futurs parents » (cocon 2, sheet « Tempo - Cocon
// sémantique 2 - futurs parents », posé le 28/10/2026).
// Requête visée : `calendrier grossesse` (59 000/mois, KD 3, Ahrefs).
// La SERP sert des calculateurs : la page ouvre donc sur l'outil, puis
// déroule tout le parcours (médical, démarches, préparatifs).
// Cadrage léger sans brief Ahrefs (quota) : brief complet à repasser après
// le 08/11/2026.
// Contenus tirés des sources officielles citées sous chaque étape, non
// relus médicalement (à faire).
// Refonte du 24/11/2026 : gabarit et composants du design system (tête de page,
// champs, tuiles, pastilles, tableau, FAQ, encart de l'app) ; calcul et textes inchangés.
import SiteLayout from '../layouts/SiteLayout.astro';
import TetePage from '../components/site/TetePage.astro';
import Tableau from '../components/site/Tableau.astro';
import { icone } from '../lib/tempo';
import Disclaimer from '../components/Disclaimer.astro';
import { phases } from '../data/calendrier-grossesse';

const title = 'Calendrier de grossesse : vos dates, SA par SA — Tempo';
const description =
  "Calculez votre calendrier de grossesse à partir des dernières règles, de la date de conception ou du terme : SA, échographies, consultations, congés, et tout ce qu'il y a à préparer.";

// Table mois de grossesse ↔ SA de santé.fr (1er mois = 3 à 6 SA…).
const monthEnds = [6, 10, 15, 19, 24, 28, 32, 36, 41];
const weeks = Array.from({ length: 39 }, (_, i) => {
  const w = i + 3;
  const m = monthEnds.findIndex((e) => w <= e) + 1;
  return { sa: w, month: m === 1 ? '1er mois' : `${m}e mois` };
});

const faq = [
  {
    question: 'Comment calculer ses semaines d’aménorrhée (SA) ?',
    answer:
      'Les SA se comptent à partir du premier jour des dernières règles, et non à partir de la conception. Comme l’ovulation a lieu environ deux semaines après les règles dans un cycle de 28 jours, on a en général 2 SA de plus que de semaines de grossesse.',
  },
  {
    question: 'Comment calculer sa date d’accouchement ?',
    answer:
      'En France, la date présumée d’accouchement est fixée à 41 SA, soit 39 semaines après la conception. C’est un repère : l’échographie du 1er trimestre, dite de datation, permet de la préciser.',
  },
  {
    question: 'Mes cycles sont longs ou irréguliers : comment faire ?',
    answer:
      'Le calcul standard suppose un cycle de 28 jours, avec une ovulation vers le 14e jour. Avec des cycles plus longs, il avance trop la grossesse. Indiquez la durée de vos cycles, ou la date de conception si vous la connaissez. Dans tous les cas, c’est l’échographie de datation qui donnera le bon terme.',
  },
  {
    question: 'Quand faut-il déclarer sa grossesse ?',
    answer:
      'Avant la fin du 3e mois de grossesse, soit avant 16 SA. C’est le médecin ou la sage-femme de la première consultation qui fait la déclaration, en ligne ou sur le formulaire papier.',
  },
  {
    question: 'Combien y a-t-il d’échographies pendant la grossesse ?',
    answer:
      'Trois échographies sont recommandées, une par trimestre : vers 12 SA (datation), au 5e mois (morphologie) et au 7e mois (position du bébé et du placenta).',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const ext = { target: '_blank', rel: 'nofollow noopener noreferrer' };
---

<SiteLayout title={title} description={description} path="/calendrier-grossesse/" actif="calendrier">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="page-simple calendrier">
    <TetePage
      titre="Calendrier de grossesse : toutes vos dates, SA par SA"
      chapeau="Entrez une date, on calcule le reste : où vous en êtes, votre date présumée d’accouchement, et chaque étape de la grossesse à sa place, des examens aux préparatifs."
      ariane="Calendrier de grossesse"
      pastille={{ texte: 'Futurs parents', nature: 'choix' }}
    />

    <form id="cal-form" class="cal-form">
      <fieldset>
        <legend class="champ__nom">Je connais…</legend>
        <div class="cal-modes" role="radiogroup">
          <label class="cal-mode"><input type="radio" name="mode" value="ddr" checked /><span>La date de mes dernières règles</span></label>
          <label class="cal-mode"><input type="radio" name="mode" value="conception" /><span>La date de conception</span></label>
          <label class="cal-mode"><input type="radio" name="mode" value="terme" /><span>Mon terme</span></label>
        </div>
      </fieldset>

      <p id="mode-hint" class="champ__note">
        Le premier jour de vos dernières règles. Si vos cycles ne font pas 28 jours, indiquez leur durée : le
        calcul se recale. Si vos cycles sont irréguliers et que vous connaissez la date de conception, choisissez
        « La date de conception » : c’est encore plus fiable.
      </p>

      <div class="cal-champs">
        <label class="champ"><span id="date-label" class="champ__nom">Premier jour des dernières règles</span><input id="cal-date" type="date" required /></label>
        <label id="cycle-field" class="champ"><span class="champ__nom">Durée de mes cycles (jours)</span><input id="cal-cycle" type="number" min="20" max="45" value="28" inputmode="numeric" /></label>
        <label class="champ"><span class="champ__nom">Vous attendez…</span>
          <select id="cal-type"><option value="1">Un bébé</option><option value="2">Des jumeaux</option></select>
        </label>
        <label class="champ"><span class="champ__nom">Ce bébé est votre…</span>
          <select id="cal-rank"><option value="1">1er ou 2e enfant</option><option value="3">3e enfant ou plus</option></select>
        </label>
      </div>

      <button type="submit" class="bouton">Voir mon calendrier</button>
      <p id="cal-error" class="cal-erreur hidden" role="alert"></p>
    </form>

    <div id="cal-summary" class="tuiles cal-tuiles hidden" aria-live="polite">
      <div class="tuile choix"><span class="tuile__tete">Aujourd’hui</span><span id="s-sa" class="tuile__valeur"></span></div>
      <div class="tuile choix"><span class="tuile__tete">Mois de grossesse</span><span id="s-mois" class="tuile__valeur"></span></div>
      <div class="tuile choix"><span class="tuile__tete">Trimestre</span><span id="s-trim" class="tuile__valeur"></span></div>
      <div class="tuile rdv"><span class="tuile__tete">Début de grossesse</span><span id="s-debut" class="tuile__valeur petite"></span></div>
      <div class="tuile rdv"><span class="tuile__tete">Terme présumé</span><span id="s-terme" class="tuile__valeur petite"></span></div>
      <div class="tuile rdv"><span class="tuile__tete">Congé maternité</span><span id="s-conge" class="tuile__valeur petite"></span></div>
    </div>

    <div class="st-texte">
      <h2>Les étapes de la grossesse</h2>
      <p class="cal-legende">
        <span class="pastille petite sante">Officiel</span> = daté par une source officielle, citée sous l’étape.
        <span class="pastille petite">Repère</span> = ce que font la plupart des parents, sans obligation.
      </p>
    </div>

    <details id="cal-past" class="cal-past hidden">
      <summary id="cal-past-summary">Déjà passé</summary>
      <ol class="cal-etapes"></ol>
    </details>

    {phases.map((phase) => (
      <div class="cal-phase" data-phase={phase.id}>
        <h3>{phase.title}</h3>
        <ol class="cal-etapes">
          {phase.steps.map((step) => (
            <li
              class="cal-step"
              data-id={step.id}
              data-from={step.from ?? ''}
              data-to={step.to ?? ''}
              data-from-term={step.fromTerm ?? ''}
              data-to-term={step.toTerm ?? ''}
              data-deadline={step.deadline ? '1' : ''}
              data-since={step.since ? '1' : ''}
            >
              <div class="cal-step__tete">
                <span class={`pastille petite ${step.kind === 'officiel' ? 'sante' : ''}`}>{step.kind === 'officiel' ? 'Officiel' : 'Repère'}</span>
                <span class="cal-status pastille petite aujourdhui hidden"></span>
                <span class="cal-quand"><span class="cal-when">{step.when}</span><b class="cal-dates"></b></span>
              </div>
              <p class="cal-step__titre">
                {step.article && !step.articleLabel ? <a href={`/${step.article}/`}>{step.title}</a> : step.title}
              </p>
              <p class="cal-step__texte">{step.text}</p>
              {step.article && step.articleLabel && <p class="cal-step__lien"><a href={`/${step.article}/`}>{step.articleLabel}</a></p>}
              {step.source && <p class="cal-step__source">Source : <a href={step.source.url} {...ext}>{step.source.label}</a></p>}
            </li>
          ))}
        </ol>
      </div>
    ))}

    <div class="st-texte">
      <h2>Le calendrier semaine par semaine</h2>
      <p>
        Les professionnels comptent en semaines d’aménorrhée (SA), à partir du premier jour des dernières règles.
        Les proches comptent en mois. Ce tableau fait le lien, et affiche vos dates une fois le calendrier calculé.
      </p>
      <Tableau>
        <thead><tr><th>SA</th><th>Mois de grossesse</th><th>Vos dates</th></tr></thead>
        <tbody id="cal-weeks">
          {weeks.map((w) => <tr data-sa={w.sa}><td>{w.sa} SA</td><td>{w.month}</td><td class="cal-week-dates">–</td></tr>)}
        </tbody>
      </Tableau>
      <p>Correspondance mois et SA : <a href="https://www.sante.fr/le-calendrier-de-grossesse" {...ext}>santé.fr, le calendrier de grossesse</a>.</p>

      <h2>Comment le calendrier est calculé</h2>
      <ul>
        <li><strong>Dernières règles</strong> : on compte les SA à partir du premier jour des règles, et le terme tombe à 41 SA. Si vos cycles ne font pas 28 jours, le calendrier se décale d’autant.</li>
        <li><strong>Date de conception</strong> : on ajoute deux semaines pour retrouver les SA. Utile si vos cycles sont longs ou irréguliers.</li>
        <li><strong>Terme</strong> : si l’échographie de datation vous a donné une date, c’est elle qui fait foi. On remonte le calendrier à partir d’elle.</li>
      </ul>

      <Disclaimer>
        Ce calendrier reprend les repères officiels du suivi de grossesse en France. Il ne remplace pas votre
        sage-femme ou votre médecin, qui adaptent le suivi à votre situation (grossesse gémellaire, suivi
        renforcé…).
      </Disclaimer>

      <h2>Questions fréquentes</h2>
      <div class="st-faq">
        {faq.map((f, k) => <details open={k === 0}><summary>{f.question}<i set:html={icone('plus', 16, 2.4)} /></summary><p>{f.answer}</p></details>)}
      </div>

      <aside class="st-encart-app">
        <div class="st-encart-app__texte">
          <span class="pastille"><Fragment set:html={icone('etoile', 13, 2.2)} /> L'app Tempo</span>
          <p class="encart-titre">Ce calendrier, semaine après semaine</p>
          <p>Tempo prépare une app qui vous montre seulement ce qui compte maintenant, et vous rappelle le reste au bon moment.</p>
          <a class="bouton secondaire" href="#liste-attente" data-ouvrir-inscription>Rejoindre la liste d'attente</a>
        </div>
        <div class="st-encart-app__tel"><img src="/images/app/calendrier.jpg" alt="L'écran Calendrier de l'app Tempo" loading="lazy" /></div>
      </aside>
    </div>
  </div>
</SiteLayout>

<style is:global>
  /* Calendrier de grossesse : mise en page propre à l'outil, valeurs du catalogue uniquement. */
  .calendrier .hidden { display: none !important; }
  .cal-form { margin: var(--e-6) 0; padding: var(--e-6); border-radius: var(--r-xl); background: var(--surface); box-shadow: var(--ombre-douce); }
  .cal-form fieldset { margin: 0; padding: 0; border: 0; }
  .cal-modes { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--e-2); }
  .cal-mode { position: relative; display: flex; align-items: center; min-height: var(--cible); padding: var(--e-3) var(--e-4); border-radius: var(--r-m); background: var(--bg); box-shadow: inset 0 0 0 1px var(--line-fort); font: 600 15px/1.3 var(--font); cursor: pointer; }
  .cal-mode input { position: absolute; opacity: 0; pointer-events: none; }
  .cal-mode:has(input:checked) { background: var(--choix-bg); color: var(--choix); box-shadow: inset 0 0 0 2px var(--choix); }
  .cal-mode:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cal-form > .champ__note { margin: var(--e-3) 0 0; }
  .cal-champs { display: grid; grid-template-columns: 1fr 1fr; gap: var(--e-4); margin: var(--e-4) 0 var(--e-6); }
  .cal-champs .champ { margin: 0; }
  .champ select { display: block; width: 100%; height: 50px; margin: 0; padding: 0 14px; border: 0; border-radius: var(--r-m); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-fort); color: var(--ink); font: 600 16px/1.3 var(--font); }
  .cal-erreur { margin: var(--e-3) 0 0; color: var(--alerte); font: 650 14px/1.4 var(--font); }
  .cal-tuiles { grid-template-columns: repeat(3, 1fr); margin: 0 0 var(--e-8); }
  .cal-tuiles .tuile { min-height: 104px; cursor: default; }
  .cal-tuiles .tuile:active { transform: none; }
  .cal-tuiles .tuile__valeur.petite { font-size: 19px; line-height: 1.25; letter-spacing: -.01em; }
  .cal-legende { font-size: 15px; }
  .cal-phase { margin: 0 0 var(--e-8); }
  .cal-phase h3 { margin: 0 0 var(--e-3); font: 800 22px/1.2 var(--font); letter-spacing: -.03em; }
  .cal-etapes { display: grid; gap: var(--e-3); margin: 0; padding: 0; list-style: none; }
  .cal-step { padding: var(--e-4) var(--e-5); border-radius: var(--r-l); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  .cal-step.is-past { opacity: .55; }
  .cal-step.is-now { box-shadow: inset 0 0 0 2px var(--accent); }
  .cal-step__tete { display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-2); margin-bottom: var(--e-2); }
  .cal-quand { font: 550 14px/1.3 var(--font); color: var(--ink-2); }
  .cal-quand b { color: var(--ink); }
  .cal-step__titre { margin: 0; font: 750 17px/1.35 var(--font); }
  .cal-step__titre a, .cal-step__lien a { color: var(--ink); text-decoration-color: var(--accent); text-underline-offset: 4px; }
  .cal-step__texte { margin: var(--e-1) 0 0; font: 500 15px/1.5 var(--font); color: var(--ink-2); }
  .cal-step__lien { margin: var(--e-2) 0 0; font: 700 15px/1.4 var(--font); }
  .cal-step__source { margin: var(--e-2) 0 0; font: 500 13px/1.4 var(--font); color: var(--ink-2); }
  .cal-step__source a { color: inherit; }
  .cal-past { margin: 0 0 var(--e-8); padding: var(--e-4) var(--e-5); border-radius: var(--r-l); background: var(--surface-2); }
  .cal-past > summary { cursor: pointer; font: 700 15px/1.4 var(--font); color: var(--ink-2); }
  .cal-past .cal-etapes { margin-top: var(--e-3); }
  #cal-weeks tr.is-now-row td { background: var(--choix-bg); font-weight: 750; }
  @media (max-width: 640px) {
    .cal-modes, .cal-champs { grid-template-columns: 1fr; }
    .cal-tuiles { grid-template-columns: 1fr 1fr; }
    .cal-form { padding: var(--e-4); }
  }
</style>

<script>
  import { TERM_DAYS } from '../data/calendrier-grossesse';

  const DAY = 86400000;
  const fmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  const fmtShort = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long' });

  const hints: Record<string, [string, string]> = {
    ddr: [
      'Premier jour des dernières règles',
      'Le premier jour de vos dernières règles. Si vos cycles ne font pas 28 jours, indiquez leur durée : le calcul se recale. Si vos cycles sont irréguliers et que vous connaissez la date de conception, choisissez « La date de conception » : c’est encore plus fiable.',
    ],
    conception: [
      'Date de conception',
      'La date de l’ovulation ou du rapport fécondant, si vous la connaissez (suivi d’ovulation, PMA…).',
    ],
    terme: [
      'Date présumée d’accouchement',
      'La date donnée par votre sage-femme ou votre médecin, en général après l’échographie de datation.',
    ],
  };

  const form = document.getElementById('cal-form') as HTMLFormElement;
  const dateInput = document.getElementById('cal-date') as HTMLInputElement;
  const rankInput = document.getElementById('cal-rank') as HTMLSelectElement;
  const typeInput = document.getElementById('cal-type') as HTMLSelectElement;
  const cycleInput = document.getElementById('cal-cycle') as HTMLInputElement;
  const cycleField = document.getElementById('cycle-field')!;
  const err = document.getElementById('cal-error')!;
  const pastBox = document.getElementById('cal-past') as HTMLDetailsElement;
  const pastList = pastBox.querySelector('ol')!;
  const steps = [...document.querySelectorAll<HTMLElement>('.cal-step')];
  const homes = new Map(steps.map((li) => [li, li.parentElement!]));

  // Date locale à minuit, sans décalage de fuseau.
  const parse = (v: string) => {
    const [y, m, d] = v.split('-').map(Number);
    return new Date(y, m - 1, d);
  };
  const addDays = (d: Date, n: number) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);
  const diffDays = (a: Date, b: Date) => Math.round((a.getTime() - b.getTime()) / DAY);
  const today = () => {
    const n = new Date();
    return new Date(n.getFullYear(), n.getMonth(), n.getDate());
  };

  // Mois de grossesse depuis les SA (table santé.fr).
  const monthFromSA = (w: number) => {
    const bounds = [6, 10, 15, 19, 24, 28, 32, 36, 41];
    const i = bounds.findIndex((b) => w <= b);
    return i === -1 ? 9 : i + 1;
  };
  const ordinal = (n: number) => (n === 1 ? '1er' : `${n}e`);

  const mode = () => (form.querySelector('input[name="mode"]:checked') as HTMLInputElement).value;

  form.querySelectorAll('input[name="mode"]').forEach((r) =>
    r.addEventListener('change', () => {
      const [label, hint] = hints[mode()];
      document.getElementById('date-label')!.textContent = label;
      document.getElementById('mode-hint')!.textContent = hint;
      cycleField.classList.toggle('hidden', mode() !== 'ddr');
    }),
  );

  const range = (a: Date, b: Date) => {
    if (a.getTime() === b.getTime()) return fmt.format(a);
    if (a.getFullYear() === b.getFullYear()) return `du ${fmtShort.format(a)} au ${fmt.format(b)}`;
    return `du ${fmt.format(a)} au ${fmt.format(b)}`;
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    err.classList.add('hidden');
    if (!dateInput.value) return;

    const input = parse(dateInput.value);
    const cycle = Number(cycleInput.value) || 28;
    if (mode() === 'ddr' && (cycle < 20 || cycle > 45)) {
      err.textContent = 'Indiquez une durée de cycle entre 20 et 45 jours.';
      err.classList.remove('hidden');
      return;
    }
    // Ovulation supposée 14 jours avant la fin du cycle : un cycle de 35 jours
    // décale le calendrier d'une semaine par rapport au calcul standard.
    const ddr =
      mode() === 'ddr'
        ? addDays(input, cycle - 28)
        : mode() === 'conception'
          ? addDays(input, -14)
          : addDays(input, -TERM_DAYS);
    const term = addDays(ddr, TERM_DAYS);
    const days = diffDays(today(), ddr);

    if (days < 0 || days > TERM_DAYS + 120) {
      err.textContent =
        days < 0
          ? 'Cette date donne une grossesse qui n’a pas encore commencé. Vérifiez la date saisie.'
          : 'Cette date est trop ancienne pour une grossesse en cours. Vérifiez la date saisie.';
      err.classList.remove('hidden');
      return;
    }

    // Résumé
    const w = Math.floor(days / 7);
    const d = days % 7;
    const pregnant = days <= TERM_DAYS + 14;
    document.getElementById('s-sa')!.textContent = pregnant ? `${w} SA${d ? ` + ${d} j` : ''}` : 'Bébé est là ?';
    document.getElementById('s-mois')!.textContent = pregnant && w >= 3 ? `${ordinal(monthFromSA(w))} mois` : '–';
    document.getElementById('s-trim')!.textContent = !pregnant
      ? '–'
      : w < 15
        ? '1er trimestre'
        : w < 29
          ? '2e trimestre'
          : '3e trimestre';
    document.getElementById('s-terme')!.textContent = fmt.format(term);
    document.getElementById('s-debut')!.textContent = fmt.format(addDays(ddr, 14));

    // Congé maternité (service-public) : prénatal / postnatal en jours.
    const twins = typeInput.value === '2';
    const third = rankInput.value === '3';
    const [pre, post] = twins ? [84, 154] : third ? [56, 126] : [42, 70];
    const congeFrom = addDays(term, -pre);
    const congeTo = addDays(term, post - 1);
    document.getElementById('s-conge')!.textContent = `${fmtShort.format(congeFrom)} → ${fmt.format(congeTo)}`;
    document.getElementById('cal-summary')!.classList.remove('hidden');

    // Étapes : on remet chaque étape dans sa phase (ordre d'origine) avant
    // de ranger les étapes passées dans le bloc replié « Déjà passé ».
    const now = today();
    steps.forEach((li) => homes.get(li)!.appendChild(li));
    steps.forEach((li) => {
      const ds = li.dataset;
      let from: Date, to: Date;
      if (ds.fromTerm !== '') {
        let ft = Number(ds.fromTerm);
        let tt = Number(ds.toTerm);
        from = addDays(term, ft);
        to = addDays(term, tt);
        if (ds.id === 'conge-maternite') {
          from = congeFrom;
          to = congeTo;
        }
      } else {
        from = addDays(ddr, Number(ds.from));
        to = addDays(ddr, Number(ds.to));
      }

      li.querySelector('.cal-dates')!.textContent = ds.deadline
        ? ` · au plus tard le ${fmt.format(to)}`
        : ds.since
          ? ` · à partir du ${fmt.format(from)}`
          : ` · ${range(from, to)}`;

      const status = li.querySelector('.cal-status') as HTMLElement;
      li.classList.remove('is-past', 'is-now');
      status.classList.add('hidden');
      if (to < now) {
        li.classList.add('is-past');
      } else if (from <= now) {
        li.classList.add('is-now');
        status.textContent = 'En ce moment';
        status.classList.remove('hidden');
      }
    });

    // Tableau semaine par semaine
    document.querySelectorAll<HTMLElement>('#cal-weeks tr').forEach((tr) => {
      const w = Number(tr.dataset.sa);
      const a = addDays(ddr, w * 7);
      const b = addDays(a, 6);
      tr.querySelector('.cal-week-dates')!.textContent = range(a, b);
      tr.classList.toggle('is-now-row', now >= a && now <= b);
    });

    const past = steps.filter((li) => li.classList.contains('is-past'));
    past.forEach((li) => pastList.appendChild(li));
    pastBox.classList.toggle('hidden', past.length === 0);
    pastBox.open = false;
    document.getElementById('cal-past-summary')!.textContent =
      `Déjà passé · ${past.length} étape${past.length > 1 ? 's' : ''} (cliquer pour revoir)`;
    document.querySelectorAll<HTMLElement>('[data-phase]').forEach((ph) => {
      ph.classList.toggle('hidden', ph.querySelector('ol')!.children.length === 0);
    });

    document.getElementById('cal-summary')!.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
</script>
