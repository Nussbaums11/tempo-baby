---
// Page auteur, créée le 25/08/2026 dans le cadre du socle E-E-A-T.
//
// POURQUOI : sur un site YMYL, Google veut pouvoir rattacher un contenu santé
// à une personne identifiable et vérifiable. Un nom en bas d'article ne suffit
// pas s'il ne mène nulle part. Cette page est la destination de la signature,
// elle porte le JSON-LD `Person` et la liste des articles écrits.
//
// Une page est générée pour CHAQUE auteur de src/data/authors.ts, même sans
// article à son nom : la page auteur sert aussi de fiche d'identité publique
// et de cible du `sameAs`. Les articles listés incluent ceux qui n'ont pas de
// champ `author` explicite mais retombent sur l'auteur par défaut.
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import TetePage from '../../components/site/TetePage.astro';
import { rubrique, illustrationPour } from '../../data/rubriques';
import { icone, illustration } from '../../lib/tempo';
import { authors, DEFAULT_AUTHOR_SLUG } from '../../data/authors';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);

  return authors.map((author) => ({
    params: { slug: author.slug },
    props: {
      author,
      articles: articles
        .filter((a) => (a.data.author ?? DEFAULT_AUTHOR_SLUG) === author.slug)
        .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime()),
    },
  }));
}

const { author, articles } = Astro.props;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  description: author.bio,
  jobTitle: author.role,
  url: new URL(`/auteurs/${author.slug}/`, Astro.site).toString(),
  worksFor: { '@type': 'Organization', name: 'Tempo', url: Astro.site?.toString() },
  ...(author.sameAs?.length ? { sameAs: author.sameAs } : {}),
};
---

<SiteLayout
  title={`${author.name} — Tempo`}
  description={author.bio}
  path={`/auteurs/${author.slug}/`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>
  <div class="page-simple">
    <TetePage titre={author.name} ariane={author.name}>
      <div class="st-meta"><div class="st-signature"><span class="st-avatar">{author.initials}</span><div><b>{author.name}</b><small>{author.role}</small></div></div></div>
    </TetePage>
    <div class="st-texte">
      <p>{author.bio}</p>
      <aside class="st-encadre retenir">
        <span class="st-encadre__icone" set:html={icone('etoile', 20, 2)} />
        <div>
          <p class="st-encadre__titre">Notre méthode</p>
          <p>Chaque affirmation médicale publiée sur Tempo est rattachée à une source officielle, citée dans l'article. Nous ne sommes pas des professionnels de santé : nous lisons, vérifions et rendons lisible ce que disent les autorités sanitaires et la recherche, et nous disons explicitement quand une pratique n'est pas prouvée. Nos contenus ne remplacent jamais l'avis d'un professionnel qui connaît votre enfant. <a href="/qui-sommes-nous/">En savoir plus sur notre approche</a>.</p>
        </div>
      </aside>
      {articles.length > 0 && <h2>{articles.length === 1 ? 'Son article' : `Ses ${articles.length} articles`}</h2>}
    </div>
    {articles.length > 0 && (
      <div class="st-cartes">
        {articles.map((a) => {
          const r = rubrique(a.data.cocon);
          return (
            <a class="st-carte" href={`/${a.id}/`}>
              <span class="st-carte__visuel" style={`--cf:var(${r.fond})`} set:html={illustration(illustrationPour(a.id, a.data.cocon), 96)} />
              <span class="st-carte__corps">
                <span><span class={`pastille petite ${r.nature}`}>{r.nom}</span></span>
                <h3>{a.data.title}</h3>
                <p>{a.data.description}</p>
              </span>
            </a>
          );
        })}
      </div>
    )}
  </div>
</SiteLayout>
